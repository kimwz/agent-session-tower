{
  "name": "agent-session-tower",
  "version": "1.13.4",
  "description": "Keep using your Claude Code and Codex harnesses. Monitor and manage multiple agent sessions in a web UI, locally or remotely.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimwz/agent-session-tower.git"
  },
  "homepage": "https://github.com/kimwz/agent-session-tower#readme",
  "bugs": {
    "url": "https://github.com/kimwz/agent-session-tower/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "session-monitor",
    "dashboard",
    "graph"
  ],
  "bin": {
    "agent-session-tower": "bin/agent-session-tower.mjs"
  },
  "files": [
    "bin",
    "dist/server",
    "dist/shared",
    "dist/client",
    "CHANGELOG.md",
    "README.md",
    "README.ko.md",
    "docs",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts run --no-open",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.server.json && vite build",
    "build:executable": "npm run build && node scripts/build-executable.mjs",
    "start": "node bin/agent-session-tower.mjs run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:executable": "node scripts/test-executable.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "preversion": "npm run check",
    "version": "node scripts/release.mjs prepare && node --import tsx --test tests/shared/app-identity.test.ts && git add shared/app-identity.ts",
    "postversion": "npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  }
}
